cc_library(
    name = "cad_pipeline",
    srcs = [
        #"distance_map.cc",
        "executor.cc",
        "flatten_surface_mesh.cc",
        "sdf_draw.cc",
        "write_ply.cc",
        "device_wgpu.cc",
    ],
    hdrs = [
        "any_geometry.h",
        "brep.h",
        "cache.h",
        "chamfer.h",
        "cube.h",
        "device_wgpu.h",
        #"distance_map.h",
        "executor.h",
        "extrude.h",
        "interpreter.h",
        "make_character.h",
        "mesh.h",
        "polygon.h",
        "sdf_draw.h",
        "sdf_shapes.h",
        "triangulate.h",
        "types.h",
        "visit_helper.h",
        "write_ply.h",
        "write_stl.h",
    ],
    additional_compiler_inputs = ["shaders/sdf.template.wgsl"],
    cxxopts = ["--embed-dir=cad_pipeline/shaders/"],
    deps = [
        "@boost.algorithm",
        "@boost.geometry",
        "@earcut",
        "@glfw",
        "@libigl",
        "@pmp",
        "@ttf2mesh",
        "@wgpu",
    ],
)

cc_binary(
    name = "cad_binary",
    srcs = ["main.cc"],
    defines = [
        "GLFW_EXPOSE_NATIVE_X11",
        "GLFW_EXPOSE_NATIVE_WAYLAND",
        "GLFW_BUILD_X11=1",
        "GLFW_BUILD_WAYLAND=1",
    ],
    env = {
        "__NV_PRIME_RENDER_OFFLOAD": "1",
        "__GLX_VENDOR_LIBRARY_NAME": "nvidia",
    },
    deps = [
        ":cad_pipeline",
    ],
)

# A rule to generate a 3D model for a static html page. Uses :cad_binary at build time
genrule(
    name = "make_model",
    srcs = [],
    outs = ["out.stl"],
    cmd = "./$(location :cad_binary) && cp ./out.stl $@",
    tools = [":cad_binary"],
    visibility = ["//visibility:public"],
)
